  const defaultScales = [
    ["Heiß", "Kalt"],
    ["Langweilig", "Spannend"],
    ["Gefährlich", "Harmlos"],
    ["Rund", "Eckig"]
  ];

  const scalesList = (typeof SCALES_DATA !== 'undefined') ? SCALES_DATA : defaultScales;

  let state = {
    target: { x: 0, y: 0 },
    guess: null,
    phase: 'IDLE',
    roundCount: 0,
    axisX: [],
    axisY: []
  };

  const grid = document.getElementById('grid');
  const targetMarker = document.getElementById('target-marker');
  const guessMarker = document.getElementById('guess-marker');
  const statusText = document.getElementById('status-text');
  const hintInput = document.getElementById('hint-input');

  function getRandomScalePair() {
    const pair = scalesList[Math.floor(Math.random() * scalesList.length)];
    return Math.random() < 0.5 ? [pair[0], pair[1]] : [pair[1], pair[0]];
  }

  function nextRound() {
    state.roundCount++;
    
    let pair1 = getRandomScalePair();
    let pair2 = getRandomScalePair();
    while (pair1[0] === pair2[0] || pair1[0] === pair2[1]) {
      pair2 = getRandomScalePair();
    }

    state.axisX = pair1;
    state.axisY = pair2;

    document.getElementById('label-left').innerText = state.axisX[0];
    document.getElementById('label-right').innerText = state.axisX[1];
    document.getElementById('label-top').innerText = state.axisY[0];
    document.getElementById('label-bottom').innerText = state.axisY[1];

    state.target = {
      x: Math.floor(Math.random() * 80) + 10,
      y: Math.floor(Math.random() * 80) + 10
    };

    state.guess = null;
    state.phase = 'SETUP';

    hintInput.value = '';
    targetMarker.style.display = 'none';
    guessMarker.style.display = 'none';
    
    targetMarker.style.left = state.target.x + '%';
    targetMarker.style.top = state.target.y + '%';

    statusText.innerText = "Runde " + state.roundCount + ": Hinweisgeber klickt auf 'Ziel anzeigen'.";
    
    document.getElementById('btn-reveal').disabled = false;
    document.getElementById('btn-submit').disabled = true;
  }

  function toggleTargetView() {
    if (state.phase === 'SETUP') {
      targetMarker.style.display = 'block';
      statusText.innerText = "Ziel sichtbar! Einprägen, Hinweis geben & verdecken.";
      document.getElementById('btn-reveal').innerText = "Ziel verdecken & weiter";
      state.phase = 'HINT_GIVEN';
    } else if (state.phase === 'HINT_GIVEN') {
      targetMarker.style.display = 'none';
      statusText.innerText = "Klicke ins Feld, um einen Tipp zu setzen.";
      document.getElementById('btn-reveal').innerText = "Ziel anzeigen (Hinweisgeber)";
      document.getElementById('btn-reveal').disabled = true;
      state.phase = 'GUESSING';
    }
  }

  grid.addEventListener('click', (e) => {
    if (state.phase !== 'GUESSING') return;

    const rect = grid.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    state.guess = { x: Math.round(x), y: Math.round(y) };

    guessMarker.style.left = state.guess.x + '%';
    guessMarker.style.top = state.guess.y + '%';
    guessMarker.style.display = 'block';

    document.getElementById('btn-submit').disabled = false;
  });

  function submitGuess() {
    if (!state.guess) return;

    state.phase = 'REVEALED';
    targetMarker.style.display = 'block';

    const dx = state.target.x - state.guess.x;
    const dy = state.target.y - state.guess.y;
    const distance = Math.sqrt(dx * dx + dy * dy);

    let points = 0;
    if (distance <= 6) points = 4;
    else if (distance <= 14) points = 3;
    else if (distance <= 24) points = 2;

    statusText.innerText = `Ergebnis: ${points} Punkte! (Abweichung: ${Math.round(distance)})`;

    document.getElementById('btn-submit').disabled = true;
    document.getElementById('btn-reveal').disabled = true;

    addHistoryEntry(points, hintInput.value.trim());
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function addHistoryEntry(points, hintText) {
    const tbody = document.getElementById('history-body');
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${state.roundCount}</td>
      <td>${state.axisX[0]} ↔ ${state.axisX[1]}</td>
      <td>${state.axisY[0]} ↔ ${state.axisY[1]}</td>
      <td>${escapeHtml(hintText) || '<em>-</em>'}</td>
      <td><strong>${points}</strong></td>
    `;
    tbody.insertBefore(tr, tbody.firstChild);
  }
</script>
