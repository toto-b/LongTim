{
  "title": "Longwave Online",
  "uid": "longwave-online",
  "tags": [
    "longwave"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datenquelle",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus",
          "selected": true
        },
        "hide": 0,
        "description": "Voreingestellt auf die Prometheus-Instanz von kube-prometheus-stack."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Was gerade läuft",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Offene Lobbys",
      "description": "Räume, die gerade existieren. Verschwinden nach LOBBY_TTL ohne Verbindung.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(longwave_lobbies_active)",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Verbundene Spieler",
      "description": "Offene WebSocket-Verbindungen über alle Lobbys.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(longwave_players_connected)",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d95926"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Runden im Zeitraum",
      "description": "Vollständig ausgewertete Runden im gewählten Zeitfenster.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(longwave_rounds_total[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#199e70"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Median-Abweichung",
      "description": "Wie weit ein typischer Tipp vom Ziel liegt, in Prozent der Feldbreite. Unter 6 gibt es die volle Punktzahl.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(longwave_guess_distance_bucket[$__range])) by (le))",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#199e70",
                "value": null
              },
              {
                "color": "#d95926",
                "value": 20
              },
              {
                "color": "#e66767",
                "value": 28
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Verlauf",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Lobbys und Spieler",
      "description": "Beide Kurven sind Stückzahlen und teilen deshalb eine Achse.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(longwave_lobbies_active)",
          "legendFormat": "Lobbys"
        },
        {
          "refId": "B",
          "expr": "sum(longwave_players_connected)",
          "legendFormat": "Spieler"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisGridShow": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lobbys"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spieler"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Runden pro Minute",
      "description": "Spieltempo. Eine Runde zählt, sobald sie aufgedeckt wurde.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(longwave_rounds_total[$__rate_interval])) * 60",
          "legendFormat": "Runden/min"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Spielbalance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "heatmap",
      "title": "Verteilung der Abweichungen",
      "description": "Jede Zelle: wie viele Tipps in diesem Abstandsband lagen. Die Bucket-Grenzen 6/14/20/28 sind genau die Punktebänder des Spiels.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(longwave_guess_distance_bucket[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "cellValues": {
          "decimals": 0
        },
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 32,
          "reverse": false,
          "exponent": 0.5,
          "fill": "#3987e5"
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "short",
          "reverse": false,
          "axisLabel": "Abweichung"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Getroffene Punktebänder",
      "description": "Wie oft welche Punktzahl vergeben wurde. Fast alles bei 4 Punkten heißt, die Skalen sind zu leicht; fast alles bei 0, sie sind zu schwer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(longwave_guess_points_total{points=\"4\"}[$__range]))",
          "legendFormat": "4 Punkte",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(longwave_guess_points_total{points=\"3\"}[$__range]))",
          "legendFormat": "3 Punkte",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum(increase(longwave_guess_points_total{points=\"2\"}[$__range]))",
          "legendFormat": "2 Punkte",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum(increase(longwave_guess_points_total{points=\"1\"}[$__range]))",
          "legendFormat": "1 Punkt",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "sum(increase(longwave_guess_points_total{points=\"0\"}[$__range]))",
          "legendFormat": "0 Punkte",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "4 Punkte"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b7d3f6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3 Punkte"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#86b6ef"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "2 Punkte"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5598e7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "1 Punkt"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "0 Punkte"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#184f95"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Dauer der Hinweisphase",
      "description": "Vom Rundenstart bis zum abgeschickten Hinweis. Beide Kurven in Sekunden, eine Achse.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(longwave_hint_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "Median"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(longwave_hint_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "95. Perzentil"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Median"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "95. Perzentil"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Vergebene Punkte pro Minute",
      "description": "Getrennt nach Rolle. Der Hinweisgeber bekommt den Schnitt seiner Gruppe, liegt also systematisch unter der Summe der Ratenden.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(longwave_points_awarded_total{role=\"guesser\"}[$__rate_interval])) * 60",
          "legendFormat": "Ratende"
        },
        {
          "refId": "B",
          "expr": "sum(rate(longwave_points_awarded_total{role=\"clue_giver\"}[$__rate_interval])) * 60",
          "legendFormat": "Hinweisgeber"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ratende"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hinweisgeber"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Betrieb",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "WebSocket-Nachrichten pro Sekunde",
          "description": "Nach Nachrichtentyp. Zeigt, ob das Protokoll mehr redet als nötig.",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 33
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(longwave_ws_messages_total[$__rate_interval])) by (direction, type)",
              "legendFormat": "{{direction}} · {{type}}"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 2,
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": true,
                "axisBorderShow": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Speicherverbrauch des Game-Servers",
          "description": "Resident Set Size je Pod, gegen das Limit von 128 MiB.",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 33
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(process_resident_memory_bytes{job=\"longwave-server\"}) by (pod)",
              "legendFormat": "{{pod}}"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": [
                "max"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "min": 0,
              "max": 134217728,
              "color": {
                "mode": "fixed",
                "fixedColor": "#3987e5"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 10,
                "showPoints": "never",
                "spanNulls": true,
                "axisBorderShow": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "stat",
          "title": "Abgeräumte leere Lobbys",
          "description": "Der Reaper entfernt Lobbys, die länger als LOBBY_TTL ohne Verbindung sind.",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 4,
            "w": 8,
            "x": 0,
            "y": 41
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(increase(longwave_lobbies_reaped_total[$__range]))",
              "instant": true
            }
          ],
          "options": {
            "colorMode": "none",
            "graphMode": "none",
            "textMode": "value",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "color": {
                "mode": "fixed",
                "fixedColor": "#3987e5"
              }
            },
            "overrides": []
          }
        },
        {
          "type": "stat",
          "title": "Abgelehnte Kommandos",
          "description": "Regelverstöße und kaputte Nachrichten. Ein Dauerausschlag deutet auf einen Fehler im Frontend hin.",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 4,
            "w": 8,
            "x": 8,
            "y": 41
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(increase(longwave_ws_errors_total[$__range]))",
              "instant": true
            }
          ],
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "value",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
